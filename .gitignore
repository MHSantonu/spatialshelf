# SpatialShelf root ignores
.env
**/.venv/
storage-shared/*
!storage-shared/.gitkeep
spikes/out/
worker/__pycache__/
spikes/__pycache__/
samples/*.mp4
samples/*.mov
node_modules

# Laravel defaults (app/ also gets its own .gitignore from the installer)
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
.env.backup
.env.production
.phpunit.cache
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
